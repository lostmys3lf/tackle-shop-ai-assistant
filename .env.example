# Salin jadi .env, lalu isi. File .env jangan di-commit ke Git.

# Pilih satu provider, isi base URL-nya:
# OpenAI     : https://api.openai.com/v1
# Groq       : https://api.groq.com/openai/v1
# Gemini     : https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter : https://openrouter.ai/api/v1
# HuggingFace: https://router.huggingface.co/v1
LLM_BASE_URL=

LLM_API_KEY=

# Nama model persis seperti di dokumentasi provider
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Langfuse Observability (opsional, kosongkan jika tidak dipakai)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Router jenis pesan: 'llm' atau 'jev'
ROUTER_PROVIDER=llm
ROUTER_JEV_MODEL=typesafe/jev
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OCR foto nota: 'groq_vision' (default via Groq Vision) atau 'paddle' (adapter lokal opsional)
OCR_PROVIDER=groq_vision
OCR_VISION_MODEL=qwen/qwen3.8-27b

# Secret key wajib untuk akses API FastAPI (header X-API-Key, tidak boleh kosong)
API_SECRET=

# URL HTTPS publik n8n untuk webhook Telegram (dari Cloudflare Quick Tunnel / domain)
WEBHOOK_URL=

# Chat ID Telegram pemilik toko (untuk allowlist n8n)
TELEGRAM_OWNER_CHAT_ID=

# Postgres di Docker (dipakai aplikasi, pgAdmin, dan MCP)
POSTGRES_USER=tackle
POSTGRES_PASSWORD=
POSTGRES_DB=tackle_shop

# Database connection string (untuk akses langsung dari host lokal)
DATABASE_URL=postgresql://tackle:password@localhost:5432/tackle_shop

# Kunci enkripsi kredensial n8n (bisa digenerate acak atau dibiarkan kosong saat awal)
N8N_ENCRYPTION_KEY=

# Kredensial admin Grafana (GRAFANA_ADMIN_PASSWORD wajib diisi untuk deploy produksi)
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

